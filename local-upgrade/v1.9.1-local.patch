++	var response callback.CardActionTriggerResponse
++	switch outcome {
++	case "accepted":
++		response.Toast = &callback.Toast{Type: "success", Content: "已收到确认"}
++	case "duplicate":
++		response.Toast = &callback.Toast{Type: "info", Content: "这张卡片已经处理过，请查看卡片状态"}
