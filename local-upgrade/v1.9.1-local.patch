++	defer func() {
++		b.mu.Lock()
++		delete(b.pending, id)
++		b.mu.Unlock()
++	}()
++
++	outcome := "failed"
++	if err == nil {
++		ctx, cancel := context.WithDeadline(ctx, start.Add(1800*time.Millisecond))
++		defer cancel()
++		select {
++		case outcome = <-wait:
++		case <-ctx.Done():
++		}
++	}
