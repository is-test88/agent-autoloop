#!/bin/sh
set -eu
base="$HOME/.agent-autoloop"
cli="$base/app/bin/agent-autoloop.ts"
if [ "${1:-}" = update ] && [ "${AGENT_AUTOLOOP_HOME:-$base}" = "$base" ] && [ -z "${AGENT_AUTOLOOP_RULES:-}" ]; then
  shift
  exec python3 -B "$base/local-upgrade/upgrade.py" "$@"
fi
if [ "${AGENT_AUTOLOOP_HOME:-$base}" = "$base" ] && [ -z "${AGENT_AUTOLOOP_RULES:-}" ]; then
  case "${1:-}" in
    --help|-h|help|'')
      "$cli" "$@"
      . "$base/local-upgrade/help-text.sh"
      exit 0
      ;;
  esac
fi
exec "$cli" "$@"
